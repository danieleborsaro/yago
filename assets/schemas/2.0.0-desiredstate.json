{
  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "x-gitops-paths": {
    "desiredstate": {
      "root": "desiredstate",
      "meta": "desiredstate.meta",
      "metaRootPath": "desiredstate.meta.parts.self",
      "metaEcosystem": "desiredstate.meta.orchestration",
      "contentEcosystem": "desiredstate.orchestration",
      "repoToLoad": "desiredstate.meta.repo.git",
      "partsToLoad": "meta.parts",
      "masterPipelineIsSelfUpdating": "desiredstate.meta.pipelines_as_code.master.is_self_updating",
      "slavePipelinesRepoList": "desiredstate.meta.pipelines_as_code.slaves",
      "concoursePipelinesRepo": "desiredstate.components.pipelines.git",
      "repoWatchList": "desiredstate.meta.repo.git.watch",
      "masterPipelineRoot": "desiredstate.meta.pipelines_as_code",
      "pipelinesPartFile": "desiredstate.meta.parts.pipelines",
      "configRepoLocatorPrimary": "desiredstate.content.environments.{environment}.configurations.{wrapper}",
      "configRepoLocatorPrimaryGit": "desiredstate.content.environments.{environment}.configurations.{wrapper}.git",
      "configRepoLocatorLegacy": "desiredstate.configuration.{environment}.{wrapper}",
      "configRepoLocatorLegacyGit": "desiredstate.configuration.{environment}.{wrapper}.git"
    }
  },

  "x-gitops-wrappers": [
    "meta",
    "terraform",
    "concourse"
  ],

  "$defs": {
    "dsMeta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "is_override_schema_in_config": {
          "type": "boolean",
          "description": "Indicates if the schema version is overriding the one in configuration"
        },
        "repo": {
          "$ref": "#/$defs/dsMetaRepo"
        },
        "change_management": {
          "$ref": "#/$defs/sharedMetaChangeManagement"
        },
        "parts": {
          "$ref": "#/$defs/sharedMetaParts"
        },
        "orchestration": {
          "$ref": "#/$defs/dsMetaOrchestration"
        },
        "pipelines_as_code": {
          "$ref": "#/$defs/dsPipelinesAsCode"
        }
      },
      "required": [
        "repo",
        "parts"
      ]
    },
    "dsMetaRepo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "git": {
          "$ref": "#/$defs/dsMetaGitSpec"
        }
      },
      "required": [
        "git"
      ]
    },
    "dsMetaGitSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "watch": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "url",
        "branch",
        "tag",
        "watch"
      ]
    },
    "dsComponentGitRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "watch": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "url",
        "branch",
        "tag",
        "path",
        "watch"
      ]
    },
    "dsOrchestrationEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "git": {
          "$ref": "#/$defs/dsComponentGitRef"
        }
      },
      "required": [
        "git"
      ]
    },
    "dsMetaOrchestration": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^.*$": {
          "$ref": "#/$defs/dsOrchestrationEntry"
        }
      },
      "minProperties": 0
    },
    "dsPipelinesAsCode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "self": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "is_self_updating": {
              "type": "boolean"
            }
          },
          "required": [
            "is_self_updating"
          ]
        },
        "children": {
          "type": "array",
          "items": true,
          "minItems": 0
        }
      },
      "required": [
        "self",
        "children"
      ]
    },
    "dsComponentDocker": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^.*$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "image": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            }
          },
          "required": [
            "image",
            "tag"
          ]
        }
      },
      "minProperties": 1
    },
    "dsComponentAmi": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^.*$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "owner": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "platform": {
              "type": "string"
            }
          },
          "required": [
            "owner",
            "name",
            "platform"
          ]
        }
      },
      "minProperties": 1
    },
    "dsComponentWeb": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^.*$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "uri": {
              "type": "string"
            }
          },
          "required": [
            "uri"
          ]
        }
      },
      "minProperties": 1
    },
    "dsComponentS3": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^.*$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "uri": {
              "type": "string"
            }
          },
          "required": [
            "uri"
          ]
        }
      },
      "minProperties": 1
    },
    "dsConfigurationEnvWrapper": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "git": {
          "$ref": "#/$defs/dsComponentGitRef"
        }
      },
      "required": [
        "git"
      ]
    },
    "dsConfigurationEnv": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^.*$": {
          "$ref": "#/$defs/dsConfigurationEnvWrapper"
        }
      },
      "minProperties": 1
    },
    "dsConfigurationRef": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^.*$": {
          "$ref": "#/$defs/dsConfigurationEnv"
        }
      },
      "minProperties": 0
    },
    "dsComponent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "git": {
          "$ref": "#/$defs/dsComponentGitRef"
        },
        "docker": {
          "$ref": "#/$defs/dsComponentDocker"
        },
        "ami": {
          "$ref": "#/$defs/dsComponentAmi"
        },
        "web": {
          "$ref": "#/$defs/dsComponentWeb"
        },
        "s3": {
          "$ref": "#/$defs/dsComponentS3"
        },
        "configuration": {
          "$ref": "#/$defs/dsConfigurationRef"
        }
      },
      "minProperties": 1
    },
    "dsTools": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^.*$": {
          "type": "string"
        }
      },
      "minProperties": 0
    },
    "sharedMetaParts": {
      "type": "object",
      "additionalProperties": true,
      "patternProperties": {
        "^self$": {
          "type": "string"
        },
        "^.*$": {
          "type": "string"
        }
      },
      "required": [
        "self"
      ]
    },
    "sharedMetaChangeManagement": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "jira_issue": {
          "type": "string"
        }
      },
      "required": [
        "jira_issue"
      ]
    }
  },

  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string"
    },
    "namespace": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "desiredstate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "meta": {
          "$ref": "#/$defs/dsMeta"
        },
        "components": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^.*$": {
              "$ref": "#/$defs/dsComponent"
            }
          },
          "minProperties": 0
        },
        "tools": {
          "$ref": "#/$defs/dsTools"
        },
        "configuration": {
          "$ref": "#/$defs/dsConfigurationRef"
        }
      },
      "required": [
        "meta"
      ]
    }
  },
  "required": [
    "schema",
    "namespace",
    "kind",
    "desiredstate"
  ]
}
