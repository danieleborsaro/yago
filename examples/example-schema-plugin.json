{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GitOps Configuration Schema Example",
  "description": "Example schema plugin showing how to specify property paths using x-gitops-paths extension",
  "type": "object",

  "x-gitops-paths": {
    "desiredstate": {
      "root": "desiredstate",
      "meta": "desiredstate.meta",
      "metaRootPath": "desiredstate.meta.parts.self",
      "metaEcosystem": "desiredstate.meta.ecosystem",
      "contentEcosystem": "desiredstate.ecosystem",
      "repoToLoad": "desiredstate.meta.repo",
      "partsToLoad": "meta.parts",
      "masterPipelineIsSelfUpdating": "desiredstate.meta.master_pipeline.master.is_self_updating",
      "slavePipelinesRepoList": "desiredstate.meta.master_pipeline.slaves"
    },
    "configuration": {
      "root": "configuration",
      "meta": "configuration.meta",
      "metaRootPath": "configuration.meta.parts.self",
      "metaEcosystem": "configuration.meta.ecosystem",
      "contentEcosystem": "configuration.ecosystem",
      "repoToLoad": "configuration.meta.repo",
      "partsToLoad": "meta.parts",
      "masterPipelineIsSelfUpdating": "configuration.meta.master_pipeline.master.is_self_updating",
      "slavePipelinesRepoList": "configuration.meta.master_pipeline.slaves"
    }
  },

  "properties": {
    "schemaVersion": {
      "type": "string",
      "description": "API version of the GitOps document"
    },
    "desiredstate": {
      "type": "object",
      "description": "Desired state configuration",
      "properties": {
        "meta": {
          "type": "object",
          "description": "Metadata for the desired state",
          "properties": {
            "parts": {
              "type": "object",
              "description": "References to component parts",
              "properties": {
                "self": {
                  "type": "string",
                  "description": "Path to the main document"
                }
              },
              "required": ["self"]
            },
            "ecosystem": {
              "type": "object",
              "description": "Sub-desired states in the ecosystem"
            },
            "repo": {
              "type": "object",
              "description": "Repository configuration",
              "properties": {
                "watch": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Files to watch for changes"
                }
              }
            },
            "master_pipeline": {
              "type": "object",
              "description": "Master pipeline configuration",
              "properties": {
                "master": {
                  "type": "object",
                  "properties": {
                    "is_self_updating": {
                      "type": "boolean",
                      "description": "Whether the master pipeline updates itself"
                    }
                  }
                },
                "slaves": {
                  "type": "array",
                  "description": "List of slave pipeline repositories",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "required": ["parts"]
        },
        "ecosystem": {
          "type": "object",
          "description": "Runtime ecosystem content"
        }
      },
      "required": ["meta"]
    },
    "configuration": {
      "type": "object",
      "description": "Configuration document",
      "properties": {
        "meta": {
          "type": "object",
          "description": "Metadata for the configuration",
          "properties": {
            "parts": {
              "type": "object",
              "description": "References to component parts",
              "properties": {
                "self": {
                  "type": "string",
                  "description": "Path to the main document"
                }
              },
              "required": ["self"]
            },
            "ecosystem": {
              "type": "object",
              "description": "Sub-configurations in the ecosystem"
            },
            "repo": {
              "type": "object",
              "description": "Repository configuration"
            },
            "master_pipeline": {
              "type": "object",
              "description": "Master pipeline configuration"
            }
          },
          "required": ["parts"]
        },
        "content": {
          "type": "object",
          "description": "Configuration content including wrappers",
          "properties": {
            "wrappers": {
              "type": "object",
              "description": "Wrapper-specific configurations",
              "patternProperties": {
                "^[a-zA-Z0-9_-]+$": {
                  "type": "object",
                  "properties": {
                    "parts": {
                      "type": "object",
                      "description": "Parts specific to this wrapper"
                    }
                  }
                }
              }
            }
          }
        },
        "ecosystem": {
          "type": "object",
          "description": "Runtime ecosystem content"
        }
      },
      "required": ["meta"]
    }
  },

  "oneOf": [
    {
      "required": ["schemaVersion", "desiredstate"]
    },
    {
      "required": ["schemaVersion", "configuration"]
    }
  ]
}
