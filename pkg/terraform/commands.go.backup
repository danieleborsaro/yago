package terraform

import (
	"fmt"
	"os"

	"github.com/danieleborsaro/yago/internal/utils/logging"
	"github.com/danieleborsaro/yago/pkg/wrapper"
	"github.com/spf13/cobra"
)

// TerraformConfig holds configuration for terraform commands.
// This matches the Python implementation's option structure from options.py
type TerraformConfig struct {
	// Common options for all commands (matching Python ClickHelper.Options)
	AWSProfile           string // -p, --aws-profile
	AWSRegion            string // -r, --aws-region (required for most commands)
	Workspace            string // -w, --workspace
	DesiredStateRoot     string // -d, --desiredstate-root (required)
	TerraformSource      string // -s, --terraform-source
	ConfigurationRoot    string // -c, --configuration-root
	Environment          string // -e, --environment

	// Command-specific flags
	IsReset              bool   // -R, --reset (init)
	IsGetProviders       bool   // -g, --get-providers (init)
	IsUpgradeModules     bool   // -u, --upgrade-modules (init)
	IsUseLocalBackend    bool   // -L, --local-backend (init)
	IsMigrateStatefile   bool   // -M, --migrate-statefile (init)
	IsPlanForDestroy     bool   // -D, --plan-for-destroy (plan)
	IsInit               bool   // -i, --init (plan)
	IsEstimateCosts      bool   // -C, --estimate-costs (plan)
	IsNoLock             bool   // -N, --no-lock (plan)
	IsDryRun             bool   // -n, --dry-run (provision/destroy)
	IsAutoApprove        bool   // -A, --auto-approve (provision/destroy)
	IsUsePlanFile        bool   // -P, --destroy-with-planfile (destroy)
	GraphType            string // -T, --graph-type (graph)
	LockId               string // -L, --lock-id (unlock)
	IsConfirmUnlock      bool   // -Y, --confirm-unlock (unlock)
	TfResourceId         string // -T, --tf-resource-id (import)
	AwsResourceId        string // -A, --aws-resource-id (import)
	OutputFile           string // -o, --output-file (output)
}

// NewTerraformCommand creates the terraform command group.
func NewTerraformCommand() *cobra.Command {
	cmd := &cobra.Command{
		Use:     "terraform",
		Aliases: []string{"tf"},
		Short:   "Terraform infrastructure operations",
		Long:    `Commands for managing Terraform infrastructure as code.`,
	}

	// Add subcommands
	cmd.AddCommand(newAssembleCommand())
	cmd.AddCommand(newInitCommand())
	cmd.AddCommand(newPlanCommand())
	cmd.AddCommand(newApplyCommand())
	cmd.AddCommand(newDestroyCommand())
	cmd.AddCommand(newValidateCommand())
	cmd.AddCommand(newOutputCommand())
	cmd.AddCommand(newWorkspaceCommand())
	cmd.AddCommand(newGraphCommand())
	cmd.AddCommand(newUnlockCommand())
	cmd.AddCommand(newImportCommand())
	cmd.AddCommand(newProvidersLockCommand())
	cmd.AddCommand(newCostsCommand())

	return cmd
}

// newAssembleCommand creates the assemble subcommand for terraform.
func newAssembleCommand() *cobra.Command {
	config := &TerraformConfig{
		BaseDir:     ".",
		Environment: "all",
		Workspace:   "default",
	}

	cmd := &cobra.Command{
		Use:   "assemble",
		Short: "Assemble Terraform configuration from GitOps files",
		Long:  `Assemble Terraform configuration files (.tfvars.json) from GitOps desired state and configuration.`,
		RunE: func(cmd *cobra.Command, args []string) error {
			return runAssemble(config, args)
		},
	}

	// Add flags
	cmd.Flags().StringVarP(&config.DesiredStateFile, "desiredstate", "d", "", "DesiredState file (required)")
	cmd.Flags().StringVarP(&config.ConfigFile, "config", "c", "", "Configuration file (optional)")
	cmd.Flags().StringVarP(&config.Environment, "environment", "e", "all", "Environment to deploy")
	cmd.Flags().StringVarP(&config.AWSProfile, "aws-profile", "p", "", "AWS profile")
	cmd.Flags().StringVarP(&config.AWSRegion, "aws-region", "r", "", "AWS region (required)")
	cmd.Flags().StringVarP(&config.Workspace, "workspace", "w", "default", "Terraform workspace")
	cmd.Flags().StringVar(&config.WorkingDir, "working-dir", "", "Working directory for output")

	cmd.MarkFlagRequired("desiredstate")
	cmd.MarkFlagRequired("aws-region")

	return cmd
}

// newInitCommand creates the init subcommand.
func newInitCommand() *cobra.Command {
	config := &TerraformConfig{
		BaseDir:   ".",
		Workspace: "default",
	}

	var (
		reconfigure   bool
		upgrade       bool
		migrateState  bool
		noBackend     bool
		backendConfig string
	)

	cmd := &cobra.Command{
		Use:   "init",
		Short: "Initialize Terraform working directory",
		Long:  `Initialize a Terraform working directory containing configuration files.`,
		RunE: func(cmd *cobra.Command, args []string) error {
			service := NewService(config.BaseDir, false)

			if config.AWSProfile != "" {
				service.SetAWSProfile(config.AWSProfile)
			}
			if config.AWSRegion != "" {
				service.SetAWSRegion(config.AWSRegion)
			}

			req := InitRequest{
				WorkingDir:        config.WorkingDir,
				BackendConfigFile: backendConfig,
				Reconfigure:       reconfigure,
				Upgrade:           upgrade,
				MigrateState:      migrateState,
				NoBackend:         noBackend,
			}

			if req.WorkingDir == "" {
				req.WorkingDir = "."
			}

			response, err := service.Init(req)
			if err != nil {
				fmt.Fprintf(os.Stderr, "Error: %v\n", err)
				if response != nil {
					fmt.Fprintln(os.Stderr, response.Output)
				}
				return err
			}

			fmt.Println(response.Output)
			logging.Info("Terraform init completed successfully")
			return nil
		},
	}

	cmd.Flags().StringVar(&config.WorkingDir, "working-dir", "", "Working directory")
	cmd.Flags().StringVarP(&config.AWSProfile, "aws-profile", "p", "", "AWS profile")
	cmd.Flags().StringVarP(&config.AWSRegion, "aws-region", "r", "", "AWS region")
	cmd.Flags().BoolVar(&reconfigure, "reconfigure", false, "Reconfigure backend")
	cmd.Flags().BoolVar(&upgrade, "upgrade", false, "Upgrade modules and plugins")
	cmd.Flags().BoolVar(&migrateState, "migrate-state", false, "Migrate state to new backend")
	cmd.Flags().BoolVar(&noBackend, "no-backend", false, "Skip backend initialization")
	cmd.Flags().StringVar(&backendConfig, "backend-config", "", "Backend configuration file")

	return cmd
}

// newPlanCommand creates the plan subcommand.
func newPlanCommand() *cobra.Command {
	config := &TerraformConfig{
		BaseDir: ".",
	}

	var (
		varsFile string
		outFile  string
		destroy  bool
	)

	cmd := &cobra.Command{
		Use:   "plan",
		Short: "Generate Terraform execution plan",
		Long:  `Create an execution plan showing what Terraform will do when you apply.`,
		RunE: func(cmd *cobra.Command, args []string) error {
			service := NewService(config.BaseDir, false)

			if config.AWSProfile != "" {
				service.SetAWSProfile(config.AWSProfile)
			}
			if config.AWSRegion != "" {
				service.SetAWSRegion(config.AWSRegion)
			}

			req := PlanRequest{
				WorkingDir: config.WorkingDir,
				VarsFile:   varsFile,
				OutFile:    outFile,
				Destroy:    destroy,
				NoLock:     config.NoLock,
			}

			if req.WorkingDir == "" {
				req.WorkingDir = "."
			}

			response, err := service.Plan(req)
			if err != nil {
				fmt.Fprintf(os.Stderr, "Error: %v\n", err)
				if response != nil {
					fmt.Fprintln(os.Stderr, response.Output)
				}
				return err
			}

			fmt.Println(response.Output)
			logging.Info("Terraform plan completed successfully")
			return nil
		},
	}

	cmd.Flags().StringVar(&config.WorkingDir, "working-dir", "", "Working directory")
	cmd.Flags().StringVarP(&config.AWSProfile, "aws-profile", "p", "", "AWS profile")
	cmd.Flags().StringVarP(&config.AWSRegion, "aws-region", "r", "", "AWS region")
	cmd.Flags().StringVar(&varsFile, "var-file", "", "Variable file (.tfvars)")
	cmd.Flags().StringVar(&outFile, "out", "", "Output plan file")
	cmd.Flags().BoolVar(&destroy, "destroy", false, "Create a plan to destroy all resources")
	cmd.Flags().BoolVar(&config.NoLock, "no-lock", false, "Don't lock state")

	return cmd
}

