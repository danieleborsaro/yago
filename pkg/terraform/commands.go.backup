			fmt.Println(response.Output)
			return nil
		},
	}

	cmd.Flags().StringVar(&config.WorkingDir, "working-dir", "", "Working directory")
	cmd.Flags().StringVarP(&config.AWSProfile, "aws-profile", "p", "", "AWS profile")
	cmd.Flags().StringVarP(&config.AWSRegion, "aws-region", "r", "", "AWS region")
	cmd.Flags().BoolVar(&jsonOutput, "json", false, "Output in JSON format")

	return cmd
}

// runAssemble executes the assemble command.
func runAssemble(config *TerraformConfig, args []string) error {
	service := NewService(config.BaseDir, false)

	if config.AWSProfile != "" {
		service.SetAWSProfile(config.AWSProfile)
	}
	if config.AWSRegion != "" {
		service.SetAWSRegion(config.AWSRegion)
	}

	// Use base service's Assemble method
	req := wrapper.AssembleRequest{
		DesiredStateFile: config.DesiredStateFile,
		ConfigFile:       config.ConfigFile,
		Environment:      config.Environment,
		Wrapper:          "terraform",
		CacheDirectory:   config.WorkingDir,
		OutputFormat:     "json", // Terraform uses JSON format for tfvars
	}

	response, err := service.Assemble(req)
	if err != nil {
		fmt.Fprintf(os.Stderr, "Error: %v\n", err)
		return err
	}

	logging.Info("Assembled files:")
	if response.DesiredStateFile != "" {
		logging.Info("  DesiredState: %s", response.DesiredStateFile)
	}
	if response.ConfigurationFile != "" {
		logging.Info("  Configuration: %s", response.ConfigurationFile)
	}

	fmt.Println("Assembly completed successfully")
	return nil
}

// newWorkspaceCommand creates the workspace subcommand for terraform.
func newWorkspaceCommand() *cobra.Command {
	config := &TerraformConfig{
		WorkingDir: ".",
	}

	var operation string

	cmd := &cobra.Command{
		Use:   "workspace [OPERATION] [NAME]",
		Short: "Manage Terraform workspaces",
		Long: `Manage Terraform workspaces: select, list, new, delete.

Examples:
  yago terraform workspace select dev
  yago terraform workspace list
  yago terraform workspace new staging
  yago terraform workspace delete old`,
		RunE: func(cmd *cobra.Command, args []string) error {
			if len(args) == 0 {
				return fmt.Errorf("operation required: select, list, new, or delete")
			}

			operation = args[0]
			workspaceName := ""
			if len(args) > 1 {
				workspaceName = args[1]
			}

			// Validate operation
			validOps := map[string]bool{"select": true, "list": true, "new": true, "delete": true}
			if !validOps[operation] {
				return fmt.Errorf("invalid operation: %s (must be select, list, new, or delete)", operation)
			}

			// Require workspace name for select, new, delete
			if operation != "list" && workspaceName == "" {
				return fmt.Errorf("workspace name required for %s operation", operation)
			}

			service := NewService(config.BaseDir, false)

			if config.AWSProfile != "" {
				service.SetAWSProfile(config.AWSProfile)
			}

			req := WorkspaceRequest{
				WorkingDir: config.WorkingDir,
				Name:       workspaceName,
				Operation:  operation,
			}

			response, err := service.Workspace(req)
			if err != nil {
				fmt.Fprintf(os.Stderr, "Error: %v\n", err)
				if response != nil {
					fmt.Fprintln(os.Stderr, response.Output)
				}
				return err
			}

			fmt.Println(response.Output)
			return nil
		},
	}

	cmd.Flags().StringVar(&config.WorkingDir, "working-dir", ".", "Working directory")
	cmd.Flags().StringVarP(&config.AWSProfile, "aws-profile", "p", "", "AWS profile")

	return cmd
}

// newGraphCommand creates the graph subcommand for terraform.
func newGraphCommand() *cobra.Command {
	config := &TerraformConfig{
		WorkingDir: ".",
	}

	var graphType string
	var outputFile string

	cmd := &cobra.Command{
		Use:   "graph",
		Short: "Generate a Terraform dependency graph",
		Long:  `Generate a visual dependency graph of Terraform resources in DOT format.`,
		RunE: func(cmd *cobra.Command, args []string) error {
			service := NewService(config.BaseDir, false)

			req := GraphRequest{
				WorkingDir: config.WorkingDir,
				Type:       graphType,
				OutputFile: outputFile,
			}

			response, err := service.Graph(req)
			if err != nil {
				fmt.Fprintf(os.Stderr, "Error: %v\n", err)
				if response != nil {
					fmt.Fprintln(os.Stderr, response.Output)
				}
				return err
			}

			if response.SVGFile != "" {
				logging.Info("Graph saved to: %s", response.SVGFile)
			} else {
				fmt.Println(response.Output)
			}
			return nil
		},
	}

	cmd.Flags().StringVar(&config.WorkingDir, "working-dir", ".", "Working directory")
	cmd.Flags().StringVar(&graphType, "type", "plan", "Graph type: plan, apply, or plan-destroy")
	cmd.Flags().StringVarP(&outputFile, "output", "o", "", "Output file path (will generate SVG if graphviz installed)")

	return cmd
}

// newUnlockCommand creates the unlock subcommand for terraform.
