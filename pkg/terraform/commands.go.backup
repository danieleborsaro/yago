// newCostsCommand creates the costs subcommand for terraform.
func newCostsCommand() *cobra.Command {
	config := &TerraformConfig{
		WorkingDir: ".",
	}

	var usePlanFile bool
	var planFile string
	var varsFiles []string

	cmd := &cobra.Command{
		Use:   "costs",
		Short: "Estimate infrastructure costs with infracost",
		Long:  `Estimate infrastructure costs using infracost tool.`,
		RunE: func(cmd *cobra.Command, args []string) error {
			service := NewService(config.BaseDir, false)

			req := CostsRequest{
				WorkingDir:  config.WorkingDir,
				UsePlanFile: usePlanFile,
				PlanFile:    planFile,
				VarsFiles:   varsFiles,
			}

			// Add AWS region as terraform var if specified
			if config.AWSRegion != "" {
				if req.TerraformVar == nil {
					req.TerraformVar = make(map[string]string)
				}
				req.TerraformVar["aws_provider_region"] = config.AWSRegion
			}

			response, err := service.Costs(req)
			if err != nil {
				fmt.Fprintf(os.Stderr, "Error: %v\n", err)
				if response != nil {
					fmt.Fprintln(os.Stderr, response.Output)
				}
				return err
			}

			fmt.Println(response.Output)
			return nil
		},
	}

	cmd.Flags().StringVar(&config.WorkingDir, "working-dir", ".", "Working directory")
	cmd.Flags().BoolVar(&usePlanFile, "use-plan-file", true, "Use plan file for cost estimation")
	cmd.Flags().StringVar(&planFile, "plan-file", "", "Path to terraform plan file")
	cmd.Flags().StringSliceVar(&varsFiles, "var-file", []string{}, "Variable files to use (can specify multiple)")
	cmd.Flags().StringVarP(&config.AWSRegion, "aws-region", "r", "", "AWS region")

	return cmd
}
